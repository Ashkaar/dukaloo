# ---- Single-shop mode (local development) -------------------------------
# Leave the Ariloo variables empty and Dukaloo serves one shop at the plain
# paths (/dashboard, /login) from this database.
DB_TURSO_DATABASE_URL=file:local.db
DB_TURSO_AUTH_TOKEN=
# The owner password until one is chosen in the app.
OWNER_PASSWORD=
# The shop's details in single-shop mode (many-shop mode reads them from Ariloo).
SHOP_NAME=Dukaloo
SHOP_CURRENCY=USD
SHOP_DECIMALS=2
SHOP_LANG=en

# ---- Many-shop mode (production) ---------------------------------------
# Setting both turns many-shop mode on: every shop registered at Ariloo for
# product 'dukaloo' is served at /<shop>/...
ARILOO_DB_URL=
ARILOO_DB_TOKEN=
# Turso group token that opens every shop's own database.
SHOPS_DB_TOKEN=
# Shared with Ariloo: signs the one-minute "Open Dukaloo" link.
DUKALOO_SSO_SECRET=
# Where Ariloo lives (logos, account links). Default https://ariloo.app
ARILOO_URL=
